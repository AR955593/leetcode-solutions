class Solution {
    static boolean isvalidAns(int arr[] , int k , int mid ){
        int ptcnt = 1;
        int ptlen = 0;
        for(int i =0; i<arr.length;i++){
           if(ptlen + arr[i]<=mid){
             ptlen = ptlen+arr[i];
           }
           else{
            ptcnt++;
            ptlen=0;
            if(ptcnt>k || arr[i]>mid){
                return false;
            }
            else{
                ptlen +=arr[i];
            }
           }
        }
        return true;
    }
    public int splitArray(int[] nums, int k) {
        int sum = 0;
        for(int i=0; i<nums.length;i++){
            sum = sum +nums[i];
        }
        int s = 0;
        int e = sum;
        int ans = -1;
        while(s<=e){
            int mid = s+(e-s)/2;
            if(isvalidAns(nums , k, mid)){
                ans = mid;
                e  =  mid -1;
            }
            else{
                s = mid+1;
            }
        }
        return ans;
    }
}
