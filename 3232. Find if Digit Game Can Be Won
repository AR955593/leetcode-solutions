class Solution {
    public boolean canAliceWin(int[] nums) {
        int sum1 =0;
        int sum2= 0;
        int n = nums.length;
        if(n<1) return false;
        for(int i: nums){
            if(i<10) sum1 = sum1 + i;
            else sum2 = sum2+i;    
        }

       
        return sum1>sum2||sum2>sum1;
    }
}
