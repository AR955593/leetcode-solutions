class Solution {
    public String reverseWords(String s) {
        String[] words = s.trim().split("\\s+");
        String ans="";
        int n = words.length-1;
        for(int i=n;i>=0;i--){
            ans = ans + words[i];
            if(i>0){
                ans = ans + " ";
            }
        }
        return ans;
    }
}
