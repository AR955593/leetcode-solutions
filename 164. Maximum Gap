class Solution {
    public int maximumGap(int[] nums) {
        if(nums.length<2){
            return 0;
        }
        int n = nums.length;
        int diff;
        int max = Integer.MIN_VALUE;
        Arrays.sort(nums);
        for(int i =0;i<n-1;i++){
            diff = Math.abs(nums[i]-nums[i+1]);
            max = Math.max(diff,max);
        }
        return max;
    }
}
